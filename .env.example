# Copy to .env (gitignored) and fill in. Never commit real values.

# --- LLM endpoint (any OpenAI-compatible API) --------------------------------
# Default is OpenRouter. To keep company data on approved infrastructure, point
# this at your company's LLM gateway or a local server (vLLM, Ollama, LM Studio).
MIRA_LLM_BASE_URL=https://openrouter.ai/api/v1
MIRA_LLM_API_KEY=
# OPENROUTER_API_KEY is still accepted as a fallback for MIRA_LLM_API_KEY.
# Cap on completion tokens per call (OpenRouter rejects uncapped requests when
# the prepaid balance is low).
MIRA_LLM_MAX_TOKENS=16000

# --- Jev (TypeSafe) — realtime triage and optional weekly pre-screen --------
TYPESAFE_API_KEY=

# --- Email (SMTP) --------------------------------------------------------------
MIRA_SMTP_HOST=smtp.office365.com
MIRA_SMTP_PORT=587
MIRA_SMTP_USER=
MIRA_SMTP_PASSWORD=
MIRA_SMTP_FROM=
# Comma-separated default recipients for digests (realtime subscribers are in
# configs/realtime.json).
MIRA_RECIPIENTS=
# Legacy (still honored): RECIPIENT_EMAIL, GMAIL_USER, GMAIL_APP_PASSWORD

# --- Paths ---------------------------------------------------------------------
# Where reports, caches, PDFs and Prefect's SQLite DB live (default ./data).
# MIRA_DATA_DIR=/srv/mira-data

# --- Optional: basic auth on the local Prefect UI/API --------------------------
# PREFECT_SERVER_API_AUTH_STRING=admin:change-me
# PREFECT_API_AUTH_STRING=admin:change-me

# Contact address sent to arXiv in the User-Agent (their API etiquette).
MIRA_CONTACT_EMAIL=
