# Prefect settings for a fully local, telemetry-free deployment.
# Loaded by `make` targets, deploy/*.service (EnvironmentFile) and deploy/*.plist.
# Every value here is safe to commit: no secrets.

# --- no phone-home -----------------------------------------------------------
PREFECT_SERVER_ANALYTICS_ENABLED=false
DO_NOT_TRACK=1
PREFECT_CLOUD_ENABLE_ORCHESTRATION_TELEMETRY=false
PREFECT_TELEMETRY_ENABLE_RESOURCE_METRICS=false
PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT=false
# The V2 UI (default since 3.8) fetches its analytics config from
# sr-client-cfg.amplitude.com on every page load even with analytics off;
# the V1 UI makes no third-party requests.
PREFECT_SERVER_UI_V2_ENABLED=false

# --- local-only server -------------------------------------------------------
PREFECT_SERVER_API_HOST=127.0.0.1
PREFECT_SERVER_API_PORT=4200
PREFECT_API_URL=http://127.0.0.1:4200/api
# Optional basic auth for the UI/API (set in .env, not here):
#   PREFECT_SERVER_API_AUTH_STRING=user:pass   (server)
#   PREFECT_API_AUTH_STRING=user:pass          (flows/CLI)

# --- state lives with the rest of the runtime data (SQLite) -----------------
# PREFECT_HOME is set by the launcher to $MIRA_DATA_DIR/prefect (default ./data/prefect).
